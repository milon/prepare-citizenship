---
import SpeakButton from './SpeakButton.astro';
import { withBase } from '../lib/paths';
import type { ClientQuestion } from '../lib/client-types';

interface Props {
  questions: ClientQuestion[];
}

const { questions } = Astro.props;
const payload = { questions };
const chaptersBase = withBase('/chapters/');
---

<script is:inline type="application/json" id="daily-data" set:html={JSON.stringify(payload).replace(/</g, '\\u003c')} />

<section
  class="card daily-question"
  x-data="dailyQuestion"
  data-chapters-base={chaptersBase}
  x-show="question"
  x-cloak
  @keydown.window="onKey($event)"
  aria-labelledby="daily-heading"
>
  <div class="card-head">
    <h2 id="daily-heading" data-i18n="daily.title">Question of the day</h2>
    <p data-i18n="daily.lede">
      One new question each calendar day. It stays put if you come back later today.
    </p>
  </div>

  <template x-if="question">
    <div>
      <p class="qmeta">
        <span class="pill pill-brand" x-text="$store.i18n.chapter(question.chapter)"></span>
        <span
          class="pill"
          x-text="question.type === 'true_false' ? $store.i18n.t('practice.tf') : $store.i18n.t('practice.mcq')"
        ></span>
        <SpeakButton id="speakId()" labelKey="practice.hear" onClick="speakPrompt" />
      </p>
      <h3 class="prompt" x-text="$store.i18n.pick(question.prompt)"></h3>
      <div class="options" role="group" :aria-label="$store.i18n.pick(question.prompt)">
        <template x-for="(option, optionIndex) in question.options" :key="option.id">
          <button
            class="option"
            type="button"
            :class="optionState(option.id)"
            @click="choose(option.id)"
            :aria-pressed="selected === option.id"
            :disabled="revealed"
          >
            <span>
              <span class="option-index" x-text="optionIndex + 1"></span>
              <span x-text="$store.i18n.pick(option.text)"></span>
            </span>
            <span class="option-mark" x-show="optionState(option.id) === 'correct'" x-text="$store.i18n.t('practice.correct')">Correct</span>
            <span class="option-mark" x-show="optionState(option.id) === 'incorrect'" x-text="$store.i18n.t('practice.incorrect')">Incorrect</span>
          </button>
        </template>
      </div>
      <div class="explain" x-show="revealed" x-cloak>
        <p x-text="$store.i18n.pick(question.explanation)"></p>
      </div>
      <p class="verified" x-show="revealed" x-text="doneNote" x-cloak>
        That is today’s question. Come back tomorrow for another.
      </p>
      <p class="button-row" x-show="revealed" x-cloak>
        <a
          class="button"
          :href="chapterHref"
          x-text="$store.i18n.t('daily.readChapter', { chapter: $store.i18n.chapter(question.chapter) })"
        >
          Read this chapter
        </a>
      </p>
    </div>
  </template>
  <p class="banner" x-show="saveFailed" x-cloak data-i18n="cards.saveFailed">
    Progress won’t save in this browser.
  </p>
</section>
