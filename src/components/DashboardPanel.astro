---
import MapleLeaf from './MapleLeaf.astro';
import { withBase } from '../lib/paths';

interface Props {
  lastVerified: string;
  compact?: boolean;
  totalQuestions?: number;
  totalCards?: number;
}

const { lastVerified, compact = false, totalQuestions = 0, totalCards = 0 } = Astro.props;

const chaptersHref = withBase('/chapters/');
const practiceHref = withBase('/practice/');
const flashcardsHref = withBase('/flashcards/');
const mockHref = withBase('/mock/');
const progressHref = withBase('/progress/');
const sessionHref = withBase('/session/');
---

<section
  x-data="dashboardPage"
  data-total-questions={totalQuestions}
  data-total-cards={totalCards}
  data-chapters-path={chaptersHref}
  data-practice-path={practiceHref}
  data-flashcards-path={flashcardsHref}
  data-mock-path={mockHref}
  data-session-path={sessionHref}
  aria-labelledby={compact ? undefined : 'dashboard-heading'}
  aria-label={compact ? 'Progress summary' : undefined}
  data-i18n-aria={compact ? 'dash.summary' : undefined}
>
  {
    !compact && (
      <div class="page-head">
        <div>
          <p class="eyebrow" data-i18n="dash.progress">Progress</p>
          <h1 id="dashboard-heading">
            <span x-show="!$store.learner.name" data-i18n="dash.readinessHeading">Readiness dashboard</span>
            <span
              x-show="$store.learner.name"
              x-cloak
              x-text="$store.i18n.t('dash.possessive', { name: $store.learner.name })"
            />
          </h1>
          <p class="verified lang-en">Officials last checked {lastVerified}.</p>
          <p class="verified lang-fr">Titulaires vérifiés le {lastVerified}.</p>
        </div>
      </div>
    )
  }

  <template x-if="stats">
    <div>
      <div class="dash-hero">
        <div class="hero-cta">
          <MapleLeaf class="leaf-wash" />
          <p class="k" x-text="$store.i18n.t('dash.next')">Recommended next</p>
          <h2 x-text="nextStep.title">Keep studying</h2>
          <p x-text="nextStep.blurb"></p>
          <div class="button-row">
            <a class="button button-on-brand" :href="nextStep.href" x-text="nextStep.cta"></a>
            <a class="button button-ghost-brand" :href="nextStep.altHref" x-text="nextStep.altCta"></a>
          </div>
        </div>

        <div class="readiness-card">
          <div class="dial" :style="`--value:${dialValue}`" :data-status="stats.readiness.status">
            <b x-text="stats.overallTotal ? percent(stats.overallRate) : '—'">—</b>
          </div>
          <div>
            <p class="k" x-text="$store.i18n.t('dash.readiness')">Readiness</p>
            <h3 x-text="readinessSummary.label"></h3>
            <p x-text="readinessSummary.note"></p>
          </div>
        </div>
      </div>

      {
        compact ? (
          <p class="button-row home-progress-link">
            <a class="button" href={progressHref} x-text="$store.i18n.t('dash.openFull')">
              Open the full dashboard
            </a>
          </p>
        ) : (
          <Fragment>
            <div class="stat-grid">
              <p class="stat">
                <span class="stat-label" x-text="$store.i18n.t('dash.seen')">Questions seen</span>
                <strong x-text="stats.seenQuestions"></strong>
                <span class="stat-sub" x-text="seenLabel"></span>
              </p>
              <p class="stat">
                <span class="stat-label" x-text="$store.i18n.t('dash.accuracy')">Accuracy</span>
                <strong x-text="stats.overallTotal ? percent(stats.overallRate) : '—'"></strong>
                <span
                  class="stat-sub"
                  x-text="stats.overallTotal
                    ? $store.i18n.t('dash.answers', { correct: stats.overallCorrect, total: stats.overallTotal })
                    : $store.i18n.t('dash.noQuiz')"
                ></span>
              </p>
              <p class="stat">
                <span class="stat-label" x-text="$store.i18n.t('dash.streak')">Study streak</span>
                <strong x-text="stats.streak"></strong>
                <span
                  class="stat-sub"
                  x-text="$store.i18n.t(stats.streak === 1 ? 'dash.streakDay' : 'dash.streakDays')"
                ></span>
              </p>
              <p class="stat">
                <span class="stat-label" x-text="$store.i18n.t('dash.mocks')">Mocks passed</span>
                <strong x-text="stats.mocksPassed"></strong>
                <span
                  class="stat-sub"
                  x-text="$store.i18n.t('dash.mockAttempts', { n: stats.mockTrend.length })"
                ></span>
              </p>
            </div>

            <div class="readiness" :data-status="stats.readiness.status" x-show="stats.readiness.status !== 'not-enough-data'" x-cloak>
              <p class="readiness-label" x-show="stats.readiness.status === 'ready'">
                <span
                  x-show="!$store.learner.name"
                  x-text="$store.i18n.t('dash.ready')"
                >Ready — last three mocks passed, and practiced chapters are at 70% or better.</span>
                <span
                  x-show="$store.learner.name"
                  x-cloak
                  x-text="$store.i18n.t('dash.readyNamed', { name: $store.learner.name })"
                ></span>
              </p>
              <p class="readiness-label" x-show="stats.readiness.status === 'not-ready'">
                <span x-show="!$store.learner.name" x-text="$store.i18n.t('dash.notReady')">Not ready yet.</span>
                <span
                  x-show="$store.learner.name"
                  x-cloak
                  x-text="$store.i18n.t('dash.notReadyNamed', { name: $store.learner.name })"
                ></span>
              </p>
              <ul class="reason-list" x-show="stats.readiness.status === 'not-ready'">
                <template x-for="reason in (stats.readiness.reasons || [])" :key="(reason.id || '') + (reason.chapterId || '')">
                  <li x-text="reasonText(reason)"></li>
                </template>
              </ul>
              <p class="stat-sub" x-show="(stats.readiness.keepPracticing || []).length">
                <span x-text="$store.i18n.t('dash.keepPracticing')">Keep practicing:</span>
                <span x-text="(stats.readiness.keepPracticing || []).map((chapter) => $store.i18n.chapter(chapter.id)).join(', ')"></span>
              </p>
            </div>

            <div class="dash-grid" style="margin-top:1rem">
              <div class="card">
                <div class="card-head">
                  <h2>
                    <span x-text="$store.i18n.t('dash.everyChapter')">Every chapter</span>
                  </h2>
                  <p x-text="$store.i18n.t('dash.belowTarget')">Red bars are below the 70% you want before the test.</p>
                </div>
                <p class="stat-sub" x-show="!stats.overallTotal">
                  <span x-text="$store.i18n.t('dash.noneAnswered')">
                    Nothing answered yet. Take a practice quiz and every chapter gets a bar here.
                  </span>
                </p>
                <ul class="breakdown" x-show="stats.overallTotal" x-cloak>
                  <template x-for="chapter in stats.chapters" :key="chapter.id">
                    <li>
                      <strong x-text="$store.i18n.chapter(chapter.id)"></strong>
                      <span
                        class="rate"
                        x-text="chapter.total ? percent(chapter.rate) : '—'"
                      ></span>
                      <span class="meter">
                        <i :style="`width:${chapter.total ? Math.max(chapter.rate * 100, 2) : 0}%`" :data-status="chapter.status"></i>
                      </span>
                      <span
                        x-text="chapter.total
                          ? $store.i18n.t('dash.answers', { correct: chapter.correct, total: chapter.total })
                          : $store.i18n.t('dash.noAnswers')"
                      ></span>
                      <span
                        :class="chapter.status === 'on-track' ? 'pill pill-ok' : chapter.status === 'weak' ? 'pill pill-brand' : 'pill'"
                        x-text="chapter.status === 'weak'
                          ? $store.i18n.t('dash.needsWork')
                          : chapter.status === 'on-track'
                            ? $store.i18n.t('dash.onTrack')
                            : $store.i18n.t('dash.keepStatus')"
                      ></span>
                    </li>
                  </template>
                </ul>
              </div>

              <div class="card">
                <div class="card-head">
                  <h2 x-text="$store.i18n.t('dash.mockScores')">Mock scores</h2>
                  <p x-text="$store.i18n.t('dash.recentMocks')">Most recent attempts, newest last.</p>
                </div>
                <p class="stat-sub" x-show="!stats.mockTrend.length">
                  <span x-text="$store.i18n.t('dash.noMocks')">No mocks yet. Sit one to start a readiness trend.</span>
                </p>
                <ol class="trend" x-show="stats.mockTrend.length">
                  <template x-for="(item, index) in stats.mockTrend" :key="index">
                    <li>
                      <span x-text="item.date"></span>
                      <span class="score" x-text="`${item.score}/${item.total}`"></span>
                      <span
                        :class="item.passed ? 'pill pill-ok' : 'pill pill-brand'"
                        x-text="item.passed ? $store.i18n.t('dash.pass') : $store.i18n.t('dash.below15')"
                      ></span>
                    </li>
                  </template>
                </ol>
                <p class="button-row">
                  <a class="button button-primary" href={mockHref} x-text="$store.i18n.t('dash.startMock')">Start a mock exam</a>
                </p>
              </div>
            </div>
          </Fragment>
        )
      }
    </div>
  </template>
</section>
