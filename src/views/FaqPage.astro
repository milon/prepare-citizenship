---
import { localeFromPathname } from '../lib/paths';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { faqItems, faqPlainText } from '../lib/faq';
import { loadStudyContent } from '../lib/study-content';

const { questions, current } = await loadStudyContent();
const lastVerified = current?.lastVerified ?? 'unknown';
const opts = { questionCount: questions.length, lastVerified };
const locale = localeFromPathname(Astro.url.pathname);
const items = faqItems(opts, 'en');
const itemsFr = faqItems(opts, 'fr');
const faqForLd = locale === 'fr' ? itemsFr : items;
const faqJson = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      inLanguage: locale === 'fr' ? 'fr-CA' : 'en-CA',
      mainEntity: faqForLd.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: { '@type': 'Answer', text: faqPlainText(item.html) },
      })),
    },
  ],
});
---

<BaseLayout
  title="FAQ"
  description="Answers about this independent Canadian citizenship test study site: the mock exam, progress, and how it differs from the official IRCC test."
  titleFr="FAQ"
  descriptionFr="Réponses sur cet outil indépendant de préparation à l’examen de citoyenneté canadienne, l’examen blanc, le progrès et les différences avec l’examen d’IRCC."
  context="FAQ"
  contextFr="FAQ"
>
  <script is:inline type="application/ld+json" set:html={faqJson} />

  <div class="page-head">
    <div>
      <h1 data-i18n="faq.title">Frequently asked questions</h1>
      <p class="lede" data-i18n="faq.lede">
        Independent practice for the Canadian citizenship test — not the test itself, and
        not affiliated with IRCC.
      </p>
    </div>
    <div class="chips">
      <span class="chip" x-data x-text="$store.i18n.t('home.questions', { n: $el.dataset.questionCount })" data-question-count={questions.length}>
        {questions.length} questions
      </span>
      <span class="chip lang-en">Verified {lastVerified}</span>
      <span class="chip lang-fr">Vérifié le {lastVerified}</span>
    </div>
  </div>

  <div class="faq-list lang-en">
    {
      items.map((item) => (
        <details class="faq-item" id={item.id}>
          <summary>
            {item.question}
            <Icon name="chevron" />
          </summary>
          <div class="faq-a" set:html={item.html} />
        </details>
      ))
    }
  </div>
  <div class="faq-list lang-fr">
    {
      itemsFr.map((item) => (
        <details class="faq-item" id={`${item.id}-fr`}>
          <summary>
            {item.question}
            <Icon name="chevron" />
          </summary>
          <div class="faq-a" set:html={item.html} />
        </details>
      ))
    }
  </div>

  <section class="card contact-card" id="contact" aria-labelledby="contact-heading" x-data="contactForm">
    <div class="card-head">
      <h2 id="contact-heading" data-i18n="contact.title">Still stuck?</h2>
      <p data-i18n="contact.lede">
        If the FAQ did not cover it, send a message. Study progress stays on this device;
        only what you type here is emailed.
      </p>
    </div>

    <p class="verified" x-show="sent" x-cloak>
      <span data-i18n="contact.sent">Thanks. The message is on its way.</span>
      <button class="button" type="button" @click="reset" data-i18n="contact.again">Send another</button>
    </p>

    <form class="contact-form" x-show="!sent" @submit.prevent="submit">
      <label class="field">
        <span data-i18n="contact.name">Your name</span>
        <input
          type="text"
          name="name"
          x-model="name"
          autocomplete="name"
          maxlength="120"
        />
      </label>
      <label class="field">
        <span data-i18n="contact.email">Email</span>
        <input
          type="email"
          name="email"
          x-model="email"
          autocomplete="email"
          required
        />
      </label>
      <label class="field contact-message">
        <span data-i18n="contact.message">Message</span>
        <textarea
          name="message"
          x-model="message"
          required
          rows="5"
          maxlength="4000"
        ></textarea>
      </label>
      <input hidden type="text" name="_gotcha" x-model="honeypot" tabindex="-1" autocomplete="off" />
      <div class="contact-actions">
        <button class="button button-primary" type="submit" :disabled="sending">
          <span x-show="!sending" data-i18n="contact.send">Send message</span>
          <span x-show="sending" x-cloak data-i18n="contact.sending">Sending…</span>
        </button>
        <p class="banner" x-show="error" x-cloak data-i18n="contact.error">
          The message could not be sent. Check your connection and try again.
        </p>
      </div>
    </form>
  </section>
  <script is:inline>
    (function () {
      var id = location.hash.replace('#', '');
      if (!id) return;
      var suffix = document.documentElement.dataset.locale === 'fr' ? '-fr' : '';
      var item = document.getElementById(id + suffix) || document.getElementById(id);
      if (item && item.tagName === 'DETAILS') item.setAttribute('open', '');
    })();
  </script>
</BaseLayout>
