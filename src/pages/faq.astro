---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { faqItems, faqPlainText } from '../lib/faq';
import { loadStudyContent } from '../lib/study-content';
import { withBase } from '../lib/paths';

const { questions, current } = await loadStudyContent();
const lastVerified = current?.lastVerified ?? 'unknown';
const opts = { questionCount: questions.length, lastVerified };
const items = faqItems(opts, 'en');
const itemsFr = faqItems(opts, 'fr');
const faqJson = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      inLanguage: 'en-CA',
      mainEntity: items.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: { '@type': 'Answer', text: faqPlainText(item.html) },
      })),
    },
    {
      '@type': 'FAQPage',
      inLanguage: 'fr-CA',
      mainEntity: itemsFr.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: { '@type': 'Answer', text: faqPlainText(item.html) },
      })),
    },
  ],
});
---

<BaseLayout
  title="FAQ"
  description="Answers about this independent Canadian citizenship test study site: the mock exam, progress, and how it differs from the official IRCC test."
  titleFr="FAQ"
  descriptionFr="Réponses sur cet outil indépendant de préparation à l’examen de citoyenneté canadienne, l’examen blanc, le progrès et les différences avec l’examen d’IRCC."
  context="FAQ"
  contextFr="FAQ"
>
  <script is:inline type="application/ld+json" set:html={faqJson} />

  <div class="page-head">
    <div>
      <h1 data-i18n="faq.title">Frequently asked questions</h1>
      <p class="lede" data-i18n="faq.lede">
        Independent practice for the Canadian citizenship test — not the test itself, and
        not affiliated with IRCC.
      </p>
    </div>
    <div class="chips">
      <span class="chip" x-data x-text="$store.i18n.t('home.questions', { n: $el.dataset.questionCount })" data-question-count={questions.length}>
        {questions.length} questions
      </span>
      <span class="chip lang-en">Verified {lastVerified}</span>
      <span class="chip lang-fr">Vérifié le {lastVerified}</span>
    </div>
  </div>

  <div class="faq-list quiz-shell lang-en">
    {
      items.map((item) => (
        <details class="faq-item" id={item.id}>
          <summary>
            {item.question}
            <Icon name="chevron" />
          </summary>
          <div class="faq-a" set:html={item.html} />
        </details>
      ))
    }
  </div>
  <div class="faq-list quiz-shell lang-fr">
    {
      itemsFr.map((item) => (
        <details class="faq-item" id={`${item.id}-fr`}>
          <summary>
            {item.question}
            <Icon name="chevron" />
          </summary>
          <div class="faq-a" set:html={item.html} />
        </details>
      ))
    }
  </div>

  <p class="faq-foot lang-en">
    Still stuck? Read a <a href={withBase('/chapters/')}>chapter</a>, try a{' '}
    <a href={withBase('/practice/')}>practice quiz</a>, or adjust{' '}
    <a href={withBase('/settings/')}>Settings</a>.
  </p>
  <p class="faq-foot lang-fr">
    Encore une question? Lisez un <a href={withBase('/chapters/')}>chapitre</a>, faites un{' '}
    <a href={withBase('/practice/')}>quiz d’exercice</a> ou modifiez les{' '}
    <a href={withBase('/settings/')}>Réglages</a>.
  </p>
  <script is:inline>
    (function () {
      var id = location.hash.replace('#', '');
      if (!id) return;
      var suffix = document.documentElement.dataset.locale === 'fr' ? '-fr' : '';
      var item = document.getElementById(id + suffix) || document.getElementById(id);
      if (item && item.tagName === 'DETAILS') item.setAttribute('open', '');
    })();
  </script>
</BaseLayout>
