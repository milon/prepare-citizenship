---
import { getCollection, render } from 'astro:content';
import AnthemPanel from '../../components/AnthemPanel.astro';
import CanadaCapitalsMap from '../../components/CanadaCapitalsMap.astro';
import ChapterNav from '../../components/ChapterNav.astro';
import Icon from '../../components/Icon.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { OFFICIAL_PDF_URL, OFFICIAL_PDF_URL_FR } from '../../lib/faq';
import { officialChapterUrl } from '../../lib/official-sources';
import { withBase } from '../../lib/paths';

export async function getStaticPaths() {
  const chapters = await getCollection('chapters');
  return chapters.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const allChapters = await getCollection('chapters');
const frenchChapters = await getCollection('chaptersFr');
const frenchById = new Map(frenchChapters.map((chapter) => [chapter.id, chapter]));
const frenchEntry = frenchById.get(entry.id);
if (!frenchEntry) {
  throw new Error(`Missing French chapter summary for ${entry.id}`);
}

const { Content } = await render(entry);
const { Content: ContentFr } = await render(frenchEntry);
const current = (await getCollection('current'))[0]?.data;
const relatedRegions = allChapters
  .filter(
    (chapter) =>
      entry.data.chapter === 'canadas-regions' &&
      !entry.data.regionGroup &&
      chapter.data.regionGroup,
  )
  .sort((a, b) => a.data.order - b.data.order);

const siblings = allChapters
  .filter((chapter) => Boolean(chapter.data.regionGroup) === Boolean(entry.data.regionGroup))
  .filter((chapter) => !entry.data.regionGroup || chapter.data.chapter === entry.data.chapter)
  .sort((a, b) => a.data.order - b.data.order);
const siblingIndex = siblings.findIndex((chapter) => chapter.id === entry.id);
const previous = siblingIndex > 0 ? siblings[siblingIndex - 1] : null;
const next = siblingIndex >= 0 ? siblings[siblingIndex + 1] : null;
const previousFr = previous ? frenchById.get(previous.id) : null;
const nextFr = next ? frenchById.get(next.id) : null;

const showOfficials = entry.id === 'how-canadians-govern-themselves' && current;

const officialUrl = officialChapterUrl(entry.data.chapter, 'en');
const officialUrlFr = officialChapterUrl(entry.data.chapter, 'fr');
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  titleFr={frenchEntry.data.title}
  descriptionFr={frenchEntry.data.description}
  contextFr={frenchEntry.data.title}
>
  <div class="chapter-layout">
    <ChapterNav chapters={allChapters} frenchById={frenchById} currentId={entry.id} />

    <article class="panel chapter-article">
      <p class="eyebrow" data-i18n="chapter.eyebrow">Chapter summary</p>
      <h1 class="lang-en">{entry.data.title}</h1>
      <h1 class="lang-fr">{frenchEntry.data.title}</h1>
      <p class="lede lang-en">{entry.data.description}</p>
      <p class="lede lang-fr">{frenchEntry.data.description}</p>
      <p class="button-row no-print">
        <button class="button" type="button" onclick="window.print()" data-i18n="chapter.print">
          Print this chapter
        </button>
      </p>

      {
        showOfficials && current && (
          <>
            <dl class="officials">
              <dt data-i18n="chapter.headOfState">Head of State</dt>
              <dd class="lang-en">{current.headOfState}</dd>
              <dd class="lang-fr">{current.headOfState.replace('King ', 'roi ')}</dd>
              <dt data-i18n="chapter.gg">Governor General</dt>
              <dd>{current.governorGeneral}</dd>
              <dt data-i18n="chapter.pm">Prime Minister</dt>
              <dd>{current.primeMinister}</dd>
              <dt data-i18n="chapter.speaker">Speaker of the House</dt>
              <dd>{current.speakerOfTheHouse}</dd>
              <dt data-i18n="chapter.party">Party in power</dt>
              <dd class="lang-en">{current.partyInPower}</dd>
              <dd class="lang-fr">
                {current.partyInPower === 'Liberal Party of Canada'
                  ? 'Parti libéral du Canada'
                  : current.partyInPower}
              </dd>
            </dl>
            <p class="verified lang-en">Officials last checked {current.lastVerified}.</p>
            <p class="verified lang-fr">Dirigeants vérifiés le {current.lastVerified}.</p>
          </>
        )
      }

      {entry.id === 'canadas-regions' && <CanadaCapitalsMap />}

      <div class="prose lang-en">
        <Content />
      </div>
      <div class="prose lang-fr">
        <ContentFr />
      </div>

      {entry.data.chapter === 'canadian-symbols' && !entry.data.regionGroup && <AnthemPanel />}

      {
        !entry.data.regionGroup && (
          <p class="button-row no-print">
            <a class="button" href={`${withBase('/flashcards/')}?chapter=${entry.data.chapter}`} data-i18n="nav.flashcards">
              Flashcards
            </a>
            <a class="button" href={`${withBase('/practice/')}?chapter=${entry.data.chapter}`} data-i18n="practice.title">
              Chapter quiz
            </a>
            <a class="button button-primary" href={withBase('/mock/')} data-i18n="nav.mock">
              Mock exam
            </a>
          </p>
        )
      }

      {
        relatedRegions.length > 0 && (
          <section aria-labelledby="region-pages">
            <h2 id="region-pages" data-i18n="chapter.regions">Region subpages</h2>
            <ul class="region-grid">
              {relatedRegions.map((region) => {
                const french = frenchById.get(region.id);
                return (
                  <li>
                    <a class="region-card" href={`${withBase('/chapters/')}${region.id}/`}>
                      <strong class="lang-en">{region.data.title}</strong>
                      <strong class="lang-fr">{french?.data.title ?? region.data.title}</strong>
                      <span class="lang-en">{region.data.description}</span>
                      <span class="lang-fr">{french?.data.description ?? region.data.description}</span>
                    </a>
                  </li>
                );
              })}
            </ul>
          </section>
        )
      }

      <section class="card official-source no-print" aria-labelledby="official-source-heading">
        <span class="sq"><Icon name="info" /></span>
        <div>
          <div class="card-head">
            <h2 id="official-source-heading" data-i18n="chapter.officialTitle">
              Read more
            </h2>
            <p data-i18n="chapter.officialLede">
              Discover Canada, the official study guide, goes into more detail on this
              chapter. Open it on Canada.ca, or download the PDF.
            </p>
          </div>
          <p class="button-row">
            <a class="button lang-en" href={officialUrl} data-i18n="chapter.officialCta">
              Read this chapter on Canada.ca
            </a>
            <a class="button lang-fr" href={officialUrlFr} data-i18n="chapter.officialCta">
              Lire ce chapitre sur Canada.ca
            </a>
            <a class="button lang-en" href={OFFICIAL_PDF_URL} data-i18n="chapter.officialPdf">
              Discover Canada (PDF)
            </a>
            <a class="button lang-fr" href={OFFICIAL_PDF_URL_FR} data-i18n="chapter.officialPdf">
              Découvrir le Canada (PDF)
            </a>
          </p>
        </div>
      </section>

      <nav class="chapter-pager" aria-label="Chapter">
        {
          previous ? (
            <a class="chapter-pager-link" href={`${withBase('/chapters/')}${previous.id}/`}>
              <span data-i18n="chapters.prev">Previous chapter</span>
              <strong class="lang-en">{previous.data.title}</strong>
              <strong class="lang-fr">{previousFr?.data.title ?? previous.data.title}</strong>
            </a>
          ) : (
            <span></span>
          )
        }
        {
          next && (
            <a class="chapter-pager-link next" href={`${withBase('/chapters/')}${next.id}/`}>
              <span data-i18n="chapters.next">Next chapter</span>
              <strong class="lang-en">{next.data.title}</strong>
              <strong class="lang-fr">{nextFr?.data.title ?? next.data.title}</strong>
            </a>
          )
        }
      </nav>
    </article>
  </div>
</BaseLayout>
