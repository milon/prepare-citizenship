---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const chapters = (await getCollection('chapters'))
  .filter((entry) => !entry.data.regionGroup)
  .sort((a, b) => a.data.order - b.data.order);

const current = (await getCollection('current'))[0]?.data;
const questions = await getCollection('questions');
---

<BaseLayout
  title="Canadian Citizenship Test Prep"
  description="Study for the Canadian citizenship test with original chapter lessons and a growing question bank."
>
  <article class="hero">
    <p class="eyebrow">Prepare with confidence</p>
    <h1>Your Canadian citizenship study companion.</h1>
    <p class="lede">
          Chapter lessons, focused flashcards, and realistic 20-question mock
          exams are on the way.
    </p>
    {
      current && (
        <p class="verified">
          Officials last checked {current.lastVerified}. Question bank: {questions.length} items.
        </p>
      )
    }
  </article>

  <section class="panel" style="margin-top: 1.25rem;" aria-labelledby="chapters-heading">
    <p class="eyebrow">Study path</p>
    <h2 id="chapters-heading" style="margin: 0; font-family: Georgia, serif; font-weight: 500;">
      Start with a chapter
    </h2>
    <p class="lede">
      Read a short original summary, then return later for flashcards and a chapter quiz.
    </p>
    <ul class="chapter-grid">
      {
        chapters.map((chapter) => (
          <li>
            <a class="chapter-card" href={`${import.meta.env.BASE_URL}chapters/${chapter.id}/`}>
              <strong>{chapter.data.title}</strong>
              <span>{chapter.data.description}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
