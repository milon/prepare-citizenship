---
import { getCollection } from 'astro:content';
import DashboardPanel from '../components/DashboardPanel.astro';
import Icon from '../components/Icon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadStudyContent } from '../lib/study-content';
import { withBase } from '../lib/paths';

const chapters = (await getCollection('chapters'))
  .filter((entry) => !entry.data.regionGroup)
  .sort((a, b) => a.data.order - b.data.order);
const frenchById = new Map((await getCollection('chaptersFr')).map((entry) => [entry.id, entry]));

const { questions, cards, current } = await loadStudyContent();
const lastVerified = current?.lastVerified ?? 'unknown';

const officialGuideUrl =
  'https://www.canada.ca/en/immigration-refugees-citizenship/services/canadian-citizenship/test/study.html';
const officialPdfUrl =
  'https://www.canada.ca/content/dam/ircc/migration/ircc/english/pdf/pub/discover.pdf';
const officialGuideUrlFr =
  'https://www.canada.ca/fr/immigration-refugies-citoyennete/services/citoyennete-canadienne/examen/etudier.html';
const officialPdfUrlFr =
  'https://www.canada.ca/content/dam/ircc/migration/ircc/francais/pdf/pub/decouvrir.pdf';
---

<BaseLayout
  title="Canadian Citizenship Test Prep"
  description="Study for the Canadian citizenship test with original chapter lessons and a growing question bank."
  titleFr="Préparation à l’examen de citoyenneté canadienne"
  descriptionFr="Préparez l’examen de citoyenneté canadienne avec des chapitres originaux et une banque de questions en expansion."
  context="Today"
  contextFr="Aujourd’hui"
>
  <div class="page-head">
    <div>
      <h1
        x-data
        x-text="$store.learner.name
          ? $store.i18n.t('home.welcome', { name: $store.learner.name })
          : $store.i18n.t('home.dashboard')"
      >
        Your study dashboard
      </h1>
      <p class="lede" data-i18n="home.lede">
        Read a chapter, drill the flashcards, then sit a timed mock exam. Progress stays
        on this device.
      </p>
    </div>
    <div class="chips">
      <span
        class="chip"
        x-data
        data-question-count={questions.length}
        x-text="$store.i18n.t('home.questions', { n: $el.dataset.questionCount })"
      >{questions.length} questions</span>
      <span class="chip lang-en">Verified {lastVerified}</span>
      <span class="chip lang-fr">Vérifié le {lastVerified}</span>
    </div>
  </div>

  <DashboardPanel
    lastVerified={lastVerified}
    compact
    totalQuestions={questions.length}
    totalCards={cards.length}
  />

  <section
    class="card install-card"
    x-data="installApp"
    x-show="visible"
    x-cloak
    aria-labelledby="install-heading"
  >
    <span class="sq"><Icon name="install" /></span>
    <div>
      <div class="card-head">
        <h2 id="install-heading" data-i18n="home.installTitle">Add this app to your home screen</h2>
        <p data-i18n="home.installLede">
          Study offline, and keep progress in an app icon instead of a browser tab. After the
          first visit it works without a network.
        </p>
      </div>
      <p class="button-row">
        <button
          class="button button-primary"
          type="button"
          x-show="canInstall"
          @click="install"
          data-i18n="home.installCta"
        >
          Install app
        </button>
        <button
          class="button"
          type="button"
          x-show="ios"
          :aria-expanded="showHow.toString()"
          aria-controls="install-ios-steps"
          @click="showHow = !showHow"
          data-i18n="home.installIosCta"
        >
          How to add it
        </button>
      </p>
      <ol id="install-ios-steps" class="install-steps" x-show="ios && showHow" x-cloak>
        <li data-i18n="home.installIos1">Tap the Share button in Safari (the square with an arrow).</li>
        <li data-i18n="home.installIos2">Scroll and choose Add to Home Screen.</li>
        <li data-i18n="home.installIos3">Tap Add. Open it from the icon next time you study.</li>
      </ol>
    </div>
  </section>

  <section class="card mock-explainer" aria-labelledby="mock-how-heading">
    <span class="sq"><Icon name="mock" /></span>
    <div>
      <div class="card-head">
        <h2 id="mock-how-heading" data-i18n="home.mockHowTitle">How mock exams work</h2>
        <p data-i18n="home.mockHowLede">
          Mocks are generated when you start—not fixed papers. Each attempt draws 20
          questions across all 10 chapters, includes your province or territory, and avoids
          earlier mock questions while fresh ones remain.
        </p>
      </div>
      <div class="chips">
        <span class="chip" data-i18n="home.mockTime">45 minutes</span>
        <span class="chip" data-i18n="home.mockPass">15/20 to pass</span>
        <span class="chip" data-i18n="home.mockUnlimited">Unlimited fresh attempts</span>
      </div>
      <p class="mock-explainer-note" data-i18n="home.mockAdaptive">
        Questions you missed get priority without replacing the balanced chapter mix. After
        submitting, review every answer or retry the exact same paper.
      </p>
      <p class="button-row">
        <a class="button button-primary" href={withBase('/mock/')} data-i18n="home.mockCta">
          Start a mock exam
        </a>
      </p>
    </div>
  </section>

  <section class="card" style="margin-top:1rem" aria-labelledby="chapters-heading">
    <div class="card-head">
      <h2 id="chapters-heading" data-i18n="chapters.ten">The ten chapters</h2>
      <p data-i18n="home.chaptersBlurb">Original study notes, then flashcards and a quiz for each one.</p>
    </div>
    <ul class="chapter-grid">
      {
        chapters.map((chapter, index) => {
          const french = frenchById.get(chapter.id);
          return (
            <li>
              <a class="chapter-card" href={`${withBase('/chapters/')}${chapter.id}/`}>
                <span class="num">{String(index + 1).padStart(2, '0')}</span>
                <strong class="lang-en">{chapter.data.title}</strong>
                <strong class="lang-fr">{french?.data.title ?? chapter.data.title}</strong>
                <span class="lang-en">{chapter.data.description}</span>
                <span class="lang-fr">{french?.data.description ?? chapter.data.description}</span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </section>

  <section class="card disclaimer" aria-labelledby="disclaimer-heading">
    <span class="sq"><Icon name="info" /></span>
    <div>
      <h2 id="disclaimer-heading" data-i18n="home.disclaimer">Independent practice, not the official test</h2>
      <p class="lang-en">
        This site is not affiliated with Immigration, Refugees and Citizenship Canada.
        Questions here are original paraphrases for study, not the real citizenship test
        bank. For the authoritative material, read the{' '}
        <a href={officialGuideUrl}>official study guide</a> or the{' '}
        <a href={officialPdfUrl}>Discover Canada PDF</a>.{' '}
        <a href={withBase('/faq/')}>Read the FAQ</a>.
      </p>
      <p class="lang-fr">
        Ce site n’est pas affilié à Immigration, Réfugiés et Citoyenneté Canada.
        Les questions sont des reformulations originales conçues pour l’étude, et non
        celles de l’examen réel. Pour consulter la matière officielle, lisez le{' '}
        <a href={officialGuideUrlFr}>guide d’étude officiel</a> ou le{' '}
        <a href={officialPdfUrlFr}>PDF Découvrir le Canada</a>.{' '}
        <a href={withBase('/faq/')}>Lire la FAQ</a>.
      </p>
    </div>
  </section>
</BaseLayout>
