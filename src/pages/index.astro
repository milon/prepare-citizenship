---
import { getCollection } from 'astro:content';
import DashboardPanel from '../components/DashboardPanel.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const chapters = (await getCollection('chapters'))
  .filter((entry) => !entry.data.regionGroup)
  .sort((a, b) => a.data.order - b.data.order);

const current = (await getCollection('current'))[0]?.data;
const questions = await getCollection('questions');
---

<BaseLayout
  title="Canadian Citizenship Test Prep"
  description="Study for the Canadian citizenship test with original chapter lessons and a growing question bank."
>
  <article class="hero">
    <p class="eyebrow">Prepare with confidence</p>
    <h1>Your Canadian citizenship study companion.</h1>
    <p class="lede">
      Read a chapter, drill flashcards, take a practice quiz, then sit a 20-question mock exam.
    </p>
    {
      current && (
        <p class="verified">
          Officials last checked {current.lastVerified}. Question bank: {questions.length} items.
        </p>
      )
    }
  </article>

  {
    current ? (
      <div style="margin-top: 1.25rem;">
        <DashboardPanel lastVerified={current.lastVerified} compact />
      </div>
    ) : (
      <div style="margin-top: 1.25rem;">
        <DashboardPanel lastVerified="unknown" compact />
      </div>
    )
  }

  <section class="panel" style="margin-top: 1.25rem;" aria-labelledby="tools-heading">
    <p class="eyebrow">Study tools</p>
    <h2 id="tools-heading" style="margin: 0; font-family: Georgia, serif; font-weight: 500;">
      Flashcards, practice, mock
    </h2>
    <ul class="chapter-grid">
      <li>
        <a class="chapter-card" href={`${import.meta.env.BASE_URL}flashcards/`}>
          <strong>Flashcards</strong>
          <span>Flip cards with a three-box review schedule.</span>
        </a>
      </li>
      <li>
        <a class="chapter-card" href={`${import.meta.env.BASE_URL}practice/`}>
          <strong>Practice quiz</strong>
          <span>Untimed questions with instant explanations.</span>
        </a>
      </li>
      <li>
        <a class="chapter-card" href={`${import.meta.env.BASE_URL}mock/`}>
          <strong>Mock exam</strong>
          <span>20 questions, 45 minutes, 15 to pass.</span>
        </a>
      </li>
    </ul>
  </section>

  <section class="panel" style="margin-top: 1.25rem;" aria-labelledby="chapters-heading">
    <p class="eyebrow">Study path</p>
    <h2 id="chapters-heading" style="margin: 0; font-family: Georgia, serif; font-weight: 500;">
      Start with a chapter
    </h2>
    <p class="lede">
      Read a short original summary, then return later for flashcards and a chapter quiz.
    </p>
    <ul class="chapter-grid">
      {
        chapters.map((chapter) => (
          <li>
            <a class="chapter-card" href={`${import.meta.env.BASE_URL}chapters/${chapter.id}/`}>
              <strong>{chapter.data.title}</strong>
              <span>{chapter.data.description}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
