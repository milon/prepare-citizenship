---
const officialGuideUrl =
  'https://www.canada.ca/en/immigration-refugees-citizenship/services/canadian-citizenship/test/study.html';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Study for the Canadian citizenship test with chapter lessons, flashcards, and realistic mock exams."
    />
    <meta name="theme-color" content="#8b1e2d" />
    <meta name="generator" content={Astro.generator} />
    <title>Canadian Citizenship Test Prep</title>
    <style>
      :root {
        color-scheme: light;
        font-family:
          Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
          "Segoe UI", sans-serif;
        color: #18201d;
        background: #f7f4ec;
      }

      * {
        box-sizing: border-box;
      }

      body {
        min-height: 100vh;
        margin: 0;
        background:
          radial-gradient(circle at 15% 10%, rgb(181 44 61 / 12%), transparent 30rem),
          #f7f4ec;
      }

      main {
        display: grid;
        min-height: 100vh;
        place-items: center;
        padding: 2rem 1.25rem;
      }

      article {
        width: min(44rem, 100%);
        padding: clamp(2rem, 6vw, 4rem);
        border: 1px solid rgb(24 32 29 / 12%);
        border-radius: 1.5rem;
        background: rgb(255 255 255 / 78%);
        box-shadow: 0 1.5rem 4rem rgb(55 38 33 / 10%);
        backdrop-filter: blur(0.75rem);
      }

      .eyebrow {
        margin: 0 0 1rem;
        color: #8b1e2d;
        font-size: 0.78rem;
        font-weight: 750;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      h1 {
        max-width: 13ch;
        margin: 0;
        font-family: Georgia, "Times New Roman", serif;
        font-size: clamp(2.6rem, 9vw, 5.25rem);
        font-weight: 500;
        letter-spacing: -0.055em;
        line-height: 0.95;
      }

      .lede {
        max-width: 34rem;
        margin: 1.5rem 0 2rem;
        color: #4d5753;
        font-size: clamp(1rem, 2.5vw, 1.2rem);
        line-height: 1.65;
      }

      .status {
        display: inline-flex;
        align-items: center;
        min-height: 2.75rem;
        padding: 0.65rem 1rem;
        border-radius: 999px;
        color: #6c1723;
        background: #f7dfe2;
        font-weight: 700;
      }

      footer {
        margin-top: 2.5rem;
        padding-top: 1.5rem;
        border-top: 1px solid rgb(24 32 29 / 12%);
        color: #68716e;
        font-size: 0.88rem;
        line-height: 1.55;
      }

      a {
        color: #781826;
        text-underline-offset: 0.2em;
      }

      a:focus-visible {
        border-radius: 0.15rem;
        outline: 3px solid #c74858;
        outline-offset: 0.25rem;
      }

      @media (prefers-reduced-motion: no-preference) {
        article {
          animation: enter 600ms ease-out both;
        }

        @keyframes enter {
          from {
            opacity: 0;
            transform: translateY(1rem);
          }
        }
      }
    </style>
  </head>
  <body>
    <main>
      <article>
        <p class="eyebrow">Prepare with confidence</p>
        <h1>Your Canadian citizenship study companion.</h1>
        <p class="lede">
          Chapter lessons, focused flashcards, and realistic 20-question mock
          exams are on the way.
        </p>
        <p class="status" role="status">Site setup complete</p>
        <footer>
          Independent study tool—not affiliated with Immigration, Refugees and
          Citizenship Canada. For authoritative material, use the
          <a href={officialGuideUrl}>official study guide</a>.
        </footer>
      </article>
    </main>
  </body>
</html>
