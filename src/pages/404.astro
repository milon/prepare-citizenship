---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import MapleLeaf from '../components/MapleLeaf.astro';
import { localeFromPathname, localeHref } from '../lib/paths';

const locale = localeFromPathname(Astro.url.pathname);
const homeHref = localeHref('/', locale);
const links = [
  {
    href: localeHref('/chapters/', locale),
    icon: 'chapters' as const,
    label: 'Chapters',
    i18n: 'nav.chapters',
    blurb: 'Original study notes for every Discover Canada chapter.',
    blurbFr: 'Notes d’étude originales pour chaque chapitre de Découvrir le Canada.',
  },
  {
    href: localeHref('/search/', locale),
    icon: 'search' as const,
    label: 'Search',
    i18n: 'nav.search',
    blurb: 'Find a chapter note or practice question on this device.',
    blurbFr: 'Trouvez une note de chapitre ou une question sur cet appareil.',
  },
  {
    href: localeHref('/practice/', locale),
    icon: 'practice' as const,
    label: 'Practice',
    i18n: 'nav.practice',
    blurb: 'Drill quizzes by chapter or mix.',
    blurbFr: 'Faites des quiz par chapitre ou en mode mixte.',
  },
  {
    href: localeHref('/faq/', locale),
    icon: 'help' as const,
    label: 'FAQ',
    i18n: 'nav.faq',
    blurb: 'How this site differs from the official IRCC test.',
    blurbFr: 'En quoi ce site diffère de l’examen officiel d’IRCC.',
  },
];
---

<BaseLayout
  title="Page not found"
  description="That page is not in Prepare Citizenship. Return to the study dashboard or browse chapters."
  titleFr="Page introuvable"
  descriptionFr="Cette page n’existe pas dans Prepare Citizenship. Revenez au tableau de bord ou parcourez les chapitres."
  context="Not found"
  contextFr="Introuvable"
>
  {/* Old GitHub Pages project URL → custom domain paths */}
  <script is:inline>
    (function () {
      var prefix = '/prepare-citizenship';
      var path = location.pathname;
      if (path === prefix || path.indexOf(prefix + '/') === 0) {
        var next = path.slice(prefix.length) || '/';
        location.replace(next + location.search + location.hash);
      }
    })();
  </script>

  <article class="not-found" aria-labelledby="not-found-title">
    <div class="not-found-mark" aria-hidden="true">
      <MapleLeaf class="not-found-leaf" />
      <span class="not-found-code">404</span>
    </div>

    <div class="page-head">
      <div>
        <h1 id="not-found-title" data-i18n="notFound.title">Page not found</h1>
        <p class="lede" data-i18n="notFound.lede">
          That address is not a study page. Head back to Today, or jump to a section below.
        </p>
      </div>
    </div>

    <p class="button-row">
      <a class="button button-primary" href={homeHref} data-i18n="notFound.back">
        Back to today
      </a>
      <a class="button" href={localeHref('/chapters/', locale)} data-i18n="home.browseChapters">
        Browse chapters
      </a>
    </p>

    <section class="card not-found-links" aria-labelledby="not-found-links-heading">
      <div class="card-head">
        <h2 id="not-found-links-heading" data-i18n="notFound.linksTitle">Useful places</h2>
        <p data-i18n="notFound.linksLede">Pick up studying from one of these pages.</p>
      </div>
      <ul class="not-found-grid">
        {
          links.map((link) => (
            <li>
              <a class="not-found-card" href={link.href}>
                <span class="sq">
                  <Icon name={link.icon} />
                </span>
                <span>
                  <strong data-i18n={link.i18n}>{link.label}</strong>
                  <span class="lang-en">{link.blurb}</span>
                  <span class="lang-fr">{link.blurbFr}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </article>
</BaseLayout>
