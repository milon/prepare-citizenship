---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/paths';
---

<BaseLayout
  title="Settings"
  description="Set your name, province, theme, and progress backup."
>
  <article class="panel quiz-shell" x-data="settingsPage">
    <p class="eyebrow">Settings</p>
    <h1>Your study place</h1>
    <p class="lede">
      Mock exams include regional questions for the province or territory you choose.
      Your name is optional and stays on this device.
    </p>
    <form class="picker" @submit.prevent="save">
      <label class="field">
        <span>Your name</span>
        <input
          type="text"
          x-model="displayName"
          :maxlength="nameMax"
          autocomplete="nickname"
          spellcheck="false"
          placeholder="Optional"
          @blur="persistSettings"
        />
      </label>
      <label class="field">
        <span>Province or territory</span>
        <select x-model="selected" required>
          <option value="" disabled>Select one</option>
          <template x-for="option in options" :key="option.code">
            <option :value="option.code" x-text="option.label"></option>
          </template>
        </select>
      </label>
      <button class="button button-primary" type="submit">Save</button>
      <p class="verified" x-show="saved" x-cloak>Saved.</p>
    </form>

    <section class="data-tools" aria-labelledby="display-heading">
      <h2 id="display-heading">Display</h2>
      <p class="lede">
        Theme and text size stay on this device with your other progress. The theme
        button in the header switches between auto, light, and dark too.
      </p>
      <div class="toolbar">
        <label class="field">
          <span>Theme</span>
          <select x-model="theme" @change="persistSettings">
            <option value="system">Match device</option>
            <option value="light">Light</option>
            <option value="dark">Dark</option>
          </select>
        </label>
        <label class="field">
          <span>Text size</span>
          <select x-model="fontSize" @change="persistSettings">
            <option value="md">Default</option>
            <option value="lg">Large</option>
            <option value="xl">Extra large</option>
          </select>
        </label>
      </div>
    </section>

    <section class="data-tools" aria-labelledby="data-heading">
      <h2 id="data-heading">Your data</h2>
      <p class="lede">
        Progress stays on this device. Export a JSON backup before you clear the
        browser, or import one you saved earlier. Add this site to your home
        screen so iOS is less likely to evict stored progress.
      </p>
      <div class="button-row">
        <button class="button button-primary" type="button" @click="exportProgress">
          Export progress
        </button>
        <label class="button">
          Import progress
          <input class="sr-only" type="file" accept="application/json,.json" @change="importProgress" />
        </label>
        <button class="button" type="button" @click="reset">Reset progress</button>
      </div>
      <p class="verified" x-show="message" x-text="message" x-cloak></p>
      <p class="banner" x-show="error" x-text="error" x-cloak></p>
    </section>

    <section class="data-tools" aria-labelledby="about-heading">
      <h2 id="about-heading">About this site</h2>
      <p class="lede">
        Independent practice, not the official test. The <a href={withBase('/faq/')}>FAQ</a>{' '}
        covers the mock format, where progress is stored, and how this bank differs from
        IRCC’s questions.
      </p>
    </section>
  </article>
</BaseLayout>
