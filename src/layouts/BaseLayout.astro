---
import { pwaInfo } from 'virtual:pwa-info';
import Icon from '../components/Icon.astro';
import MapleLeaf from '../components/MapleLeaf.astro';
import StorageBanner from '../components/StorageBanner.astro';
import {
  isHomePath,
  localeFromPathname,
  localeHref,
  stripLocalePrefix,
  withBase,
  type AppLocale,
} from '../lib/paths';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  context?: string;
  titleFr?: string;
  descriptionFr?: string;
  contextFr?: string;
  /** Extra JSON-LD graph nodes merged with the default WebSite / WebPage. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  context,
  titleFr = title,
  descriptionFr = description,
  contextFr = context ?? titleFr,
  jsonLd,
} = Astro.props;

const path = Astro.url.pathname;
const locale: AppLocale = localeFromPathname(path);
const isFr = locale === 'fr';
const homeHref = localeHref('/', locale);
const pathBare = stripLocalePrefix(path);
const siteOrigin = Astro.site?.origin ?? 'https://preparecitizenship.ca';

const canonical = new URL(path, Astro.site).href;
const enUrl = new URL(localeHref(pathBare, 'en'), Astro.site).href;
const frUrl = new URL(localeHref(pathBare, 'fr'), Astro.site).href;
const ogImage = new URL(withBase('/og.png'), Astro.site).href;
const llmsUrl = new URL(withBase('/llms.txt'), Astro.site).href;
const indexMdUrl = new URL(withBase('/index.md'), Astro.site).href;
const apiCatalogUrl = new URL(withBase('/.well-known/api-catalog'), Astro.site).href;
const openApiUrl = new URL(withBase('/openapi.json'), Astro.site).href;
const sitemapUrl = new URL(withBase('/sitemap-index.xml'), Astro.site).href;

const isHome = isHomePath(path);
const pageTitle = isFr ? titleFr : title;
const pageDescription = isFr ? descriptionFr : description;
const ogTitleEn = isHome ? title : `${title} · Prepare Citizenship`;
const ogTitleFr = isHome ? titleFr : `${titleFr} · Prepare Citizenship`;
const pageOgTitle = isFr ? ogTitleFr : ogTitleEn;
const htmlLang = isFr ? 'fr-CA' : 'en-CA';
const pageInLanguage = isFr ? 'fr-CA' : 'en-CA';
const ogLocale = isFr ? 'fr_CA' : 'en_CA';
const ogLocaleAlt = isFr ? 'en_CA' : 'fr_CA';
const ogImageAlt = isFr
  ? 'Prepare Citizenship — préparation à l’examen de citoyenneté. Gratuit, sans compte et accessible hors ligne.'
  : 'Prepare Citizenship — practice for the citizenship test. Free, no account, works offline.';
const appleTitle = isFr ? 'Citoyenneté' : 'Citizenship';

const extraLd = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const siteJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteOrigin}/#website`,
      name: 'Prepare Citizenship',
      url: `${siteOrigin}/`,
      description: isFr
        ? 'Préparez l’examen de citoyenneté canadienne avec des chapitres originaux et une banque de questions en expansion.'
        : 'Study for the Canadian citizenship test with original chapter lessons and a growing question bank.',
      inLanguage: ['en-CA', 'fr-CA'],
      isAccessibleForFree: true,
    },
    {
      '@type': 'WebPage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: pageTitle,
      description: pageDescription,
      isPartOf: { '@id': `${siteOrigin}/#website` },
      inLanguage: pageInLanguage,
    },
    ...extraLd,
  ],
});

const nav = [
  { href: homeHref, label: 'Today', i18n: 'nav.today', icon: 'today', current: isHome, tab: true },
  {
    href: localeHref('/chapters/', locale),
    label: 'Chapters',
    i18n: 'nav.chapters',
    icon: 'chapters',
    current: pathBare.includes('/chapters'),
    tab: true,
  },
  {
    href: localeHref('/flashcards/', locale),
    label: 'Flashcards',
    i18n: 'nav.flashcards',
    tabI18n: 'nav.cards',
    icon: 'cards',
    current: pathBare.includes('/flashcards'),
    tab: true,
    tabLabel: 'Cards',
  },
  {
    href: localeHref('/practice/', locale),
    label: 'Practice',
    i18n: 'nav.practice',
    icon: 'practice',
    current: pathBare.includes('/practice'),
    tab: true,
  },
  {
    href: localeHref('/mock/', locale),
    label: 'Mock exam',
    i18n: 'nav.mock',
    tabI18n: 'nav.mockShort',
    icon: 'mock',
    current: pathBare.includes('/mock'),
    tab: true,
    tabLabel: 'Mock',
  },
  {
    href: localeHref('/progress/', locale),
    label: 'Progress',
    i18n: 'nav.progress',
    icon: 'progress',
    current: pathBare.includes('/progress'),
    topbar: true,
  },
  {
    href: localeHref('/faq/', locale),
    label: 'FAQ',
    i18n: 'nav.faq',
    icon: 'help',
    current: pathBare.includes('/faq'),
  },
  {
    href: localeHref('/search/', locale),
    label: 'Search',
    i18n: 'nav.search',
    icon: 'search',
    current: pathBare.includes('/search'),
    topbar: true,
  },
  {
    href: localeHref('/settings/', locale),
    label: 'Settings',
    i18n: 'nav.settings',
    icon: 'settings',
    current: pathBare.includes('/settings'),
    topbar: true,
  },
] as const;

const tabs = nav.filter((item) => 'tab' in item && item.tab);
const topbarLinks = nav.filter((item) => 'topbar' in item && item.topbar);
const settingsHref = localeHref('/settings/', locale);
const frManifestHref = withBase('/manifest-fr.webmanifest');
---

<!doctype html>
<html
  lang={htmlLang}
  data-locale={locale}
  data-theme="system"
  data-resolved="light"
  data-font="md"
  data-title-en={title}
  data-title-fr={titleFr}
  data-description-en={description}
  data-description-fr={descriptionFr}
  data-og-title-en={ogTitleEn}
  data-og-title-fr={ogTitleFr}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDescription} />
    <meta name="theme-color" content="#131925" />
    <meta name="color-scheme" content="light dark" />
    <meta name="generator" content={Astro.generator} />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content={appleTitle} />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en-CA" href={enUrl} />
    <link rel="alternate" hreflang="fr-CA" href={frUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />
    <link rel="describedby" href={llmsUrl} type="text/markdown" title="llms.txt" />
    <link rel="alternate" type="text/markdown" href={indexMdUrl} title="Markdown overview" />
    <link
      rel="api-catalog"
      href={apiCatalogUrl}
      type="application/linkset+json"
      title="API catalog"
    />
    <link rel="service-desc" href={openApiUrl} type="application/openapi+json" title="OpenAPI" />
    <link rel="sitemap" type="application/xml" href={sitemapUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Prepare Citizenship" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlt} />
    <meta property="og:title" content={pageOgTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageOgTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    {
      isFr ? (
        <link rel="manifest" href={frManifestHref} />
      ) : (
        pwaInfo && <Fragment set:html={pwaInfo.webManifest.linkTag} />
      )
    }
    <title>{pageTitle}</title>
    <script is:inline type="application/ld+json" set:html={siteJsonLd} />
    <script src="../pwa.ts"></script>
    <script is:inline>
      (function () {
        try {
          var pathLocale =
            document.documentElement.getAttribute('data-locale') === 'fr' ? 'fr' : 'en';
          var raw = localStorage.getItem('prepare-citizenship.progress.v1');
          var progress = raw ? JSON.parse(raw) : null;
          var settings = (progress && progress.settings) || {};
          // URL wins: keep storage in sync with the language of this page.
          if (progress && progress.settings && settings.locale !== pathLocale) {
            progress.settings.locale = pathLocale;
            localStorage.setItem('prepare-citizenship.progress.v1', JSON.stringify(progress));
            settings = progress.settings;
          }
          var locale = pathLocale;
          var theme =
            settings.theme === 'light' || settings.theme === 'dark' ? settings.theme : 'system';
          var font = settings.fontSize === 'lg' || settings.fontSize === 'xl' ? settings.fontSize : 'md';
          var dark =
            theme === 'dark' ||
            (theme === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
          document.documentElement.lang = locale === 'fr' ? 'fr-CA' : 'en-CA';
          document.documentElement.dataset.locale = locale;
          document.documentElement.dataset.theme = theme;
          document.documentElement.dataset.resolved = dark ? 'dark' : 'light';
          document.documentElement.dataset.font = font;
        } catch (error) {
          /* keep SSR defaults */
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main" data-i18n="skip">Skip to content</a>
    <div class="app">
      <aside class="rail">
        <a class="rail-brand" href={homeHref}>
          <MapleLeaf />
          Prepare Citizenship
        </a>
        <nav class="rail-nav" aria-label="Primary" data-i18n-aria="nav.primary">
          {
            nav.map((item) => (
              <a href={item.href} aria-current={item.current ? 'page' : undefined}>
                <Icon name={item.icon} />
                <span data-i18n={item.i18n}>{item.label}</span>
              </a>
            ))
          }
        </nav>
        <div class="rail-widget" x-data="dashboardPage">
          <template x-if="stats">
            <div>
              <p class="k" x-text="$store.i18n.t('rail.streak')">Study streak</p>
              <p class="v" x-text="$store.i18n.t(stats.streak === 1 ? 'rail.day' : 'rail.days', { n: stats.streak })"></p>
              <p class="k" style="margin-top:0.8rem" x-text="$store.i18n.t('rail.accuracy')">Accuracy</p>
              <p
                class="v"
                x-text="stats.overallTotal ? $store.i18n.t('rail.of', { pct: Math.round(stats.overallRate * 100), total: stats.overallTotal }) : $store.i18n.t('rail.noAnswers')"
              ></p>
            </div>
          </template>
        </div>
        <a class="rail-user" href={settingsHref} x-data>
          <span class="avatar" aria-hidden="true">
            <span class="avatar-leaf" x-show="!$store.learner.name">
              <MapleLeaf class="avatar-glyph" />
            </span>
            <span
              x-show="$store.learner.name"
              x-cloak
              x-text="($store.learner.name || '').slice(0, 1).toUpperCase()"></span>
          </span>
          <span class="rail-user-text">
            <strong x-text="$store.learner.name || $store.i18n.t('brand.addName')">Add your name</strong>
            <span data-i18n="nav.settings">Settings</span>
          </span>
          <Icon name="chevron" />
        </a>
      </aside>

      <div class="content">
        <header class="topbar" x-data="siteHeader">
          <a class="topbar-brand" href={homeHref}>
            <MapleLeaf />
            <span class="brand-full">Prepare Citizenship</span>
            <span class="brand-short lang-en">Citizenship</span>
            <span class="brand-short lang-fr">Citoyenneté</span>
          </a>
          <p class="topbar-context">
            <span class="lang-en">{context ?? title}</span>
            <span class="lang-fr">{contextFr}</span>
          </p>
          <div class="topbar-actions">
            {
              topbarLinks.map((item) => (
                <a
                  class="icon-button only-mobile"
                  href={item.href}
                  aria-label={item.label}
                  title={item.label}
                  data-i18n-aria={item.i18n}
                  data-i18n-title={item.i18n}
                  aria-current={item.current ? 'page' : undefined}
                >
                  <Icon name={item.icon} />
                </a>
              ))
            }
            <button
              class="icon-button"
              type="button"
              @click="cycleTheme"
              :aria-label="$store.i18n.t('theme.switch', { current: themeLabel, next: nextThemeLabel })"
              :title="$store.i18n.t('theme.switch', { current: themeLabel, next: nextThemeLabel })"
            >
              <span x-show="theme === 'system'"><Icon name="auto" /></span>
              <span x-show="theme === 'light'" x-cloak><Icon name="sun" /></span>
              <span x-show="theme === 'dark'" x-cloak><Icon name="moon" /></span>
              <span class="theme-label" x-text="themeLabel">Auto</span>
            </button>
          </div>
        </header>

        <StorageBanner />

        <main id="main" class="site-main" tabindex="-1">
          <slot />
        </main>
      </div>
    </div>

    <nav class="tabbar" aria-label="Sections" data-i18n-aria="nav.sections">
      {
        tabs.map((item) => (
          <a href={item.href} aria-current={item.current ? 'page' : undefined}>
            <Icon name={item.icon} />
            <span data-i18n={'tabI18n' in item ? item.tabI18n : item.i18n}>
              {'tabLabel' in item ? item.tabLabel : item.label}
            </span>
          </a>
        ))
      }
    </nav>
  </body>
</html>
