---
import { pwaInfo } from 'virtual:pwa-info';
import Icon from '../components/Icon.astro';
import MapleLeaf from '../components/MapleLeaf.astro';
import StorageBanner from '../components/StorageBanner.astro';
import { withBase } from '../lib/paths';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  context?: string;
  titleFr?: string;
  descriptionFr?: string;
  contextFr?: string;
  /** Extra JSON-LD graph nodes merged with the default WebSite / WebPage. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, context, titleFr = title, descriptionFr = description, contextFr = context ?? titleFr, jsonLd } = Astro.props;
const base = import.meta.env.BASE_URL;
const homeHref = base.endsWith('/') ? base : `${base}/`;
const path = Astro.url.pathname;
const siteOrigin = Astro.site?.origin ?? 'https://preparecitizenship.ca';

const canonical = new URL(path, Astro.site).href;
const ogImage = new URL(withBase('/og.png'), Astro.site).href;
const llmsUrl = new URL(withBase('/llms.txt'), Astro.site).href;
const indexMdUrl = new URL(withBase('/index.md'), Astro.site).href;
const apiCatalogUrl = new URL(withBase('/.well-known/api-catalog'), Astro.site).href;
const openApiUrl = new URL(withBase('/openapi.json'), Astro.site).href;
const sitemapUrl = new URL(withBase('/sitemap-index.xml'), Astro.site).href;

const isHome = path === homeHref || path === base;
const ogTitle = isHome ? title : `${title} · Prepare Citizenship`;
const ogTitleFr = isHome ? titleFr : `${titleFr} · Prepare Citizenship`;

const extraLd = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const siteJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteOrigin}/#website`,
      name: 'Prepare Citizenship',
      url: `${siteOrigin}/`,
      description:
        'Study for the Canadian citizenship test with original chapter lessons and a growing question bank.',
      inLanguage: ['en-CA', 'fr-CA'],
      isAccessibleForFree: true,
    },
    {
      '@type': 'WebPage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: title,
      description,
      isPartOf: { '@id': `${siteOrigin}/#website` },
      inLanguage: ['en-CA', 'fr-CA'],
    },
    ...extraLd,
  ],
});

const nav = [
  { href: homeHref, label: 'Today', i18n: 'nav.today', icon: 'today', current: isHome, tab: true },
  {
    href: `${homeHref}chapters/`,
    label: 'Chapters',
    i18n: 'nav.chapters',
    icon: 'chapters',
    current: path.includes('/chapters'),
    tab: true,
  },
  {
    href: `${homeHref}flashcards/`,
    label: 'Flashcards',
    i18n: 'nav.flashcards',
    tabI18n: 'nav.cards',
    icon: 'cards',
    current: path.includes('/flashcards'),
    tab: true,
    tabLabel: 'Cards',
  },
  {
    href: `${homeHref}practice/`,
    label: 'Practice',
    i18n: 'nav.practice',
    icon: 'practice',
    current: path.includes('/practice'),
    tab: true,
  },
  {
    href: `${homeHref}mock/`,
    label: 'Mock exam',
    i18n: 'nav.mock',
    tabI18n: 'nav.mockShort',
    icon: 'mock',
    current: path.includes('/mock'),
    tab: true,
    tabLabel: 'Mock',
  },
  {
    href: `${homeHref}progress/`,
    label: 'Progress',
    i18n: 'nav.progress',
    icon: 'progress',
    current: path.includes('/progress'),
    topbar: true,
  },
  {
    href: `${homeHref}faq/`,
    label: 'FAQ',
    i18n: 'nav.faq',
    icon: 'help',
    current: path.includes('/faq'),
  },
  {
    href: `${homeHref}search/`,
    label: 'Search',
    i18n: 'nav.search',
    icon: 'search',
    current: path.includes('/search'),
    topbar: true,
  },
  {
    href: `${homeHref}settings/`,
    label: 'Settings',
    i18n: 'nav.settings',
    icon: 'settings',
    current: path.includes('/settings'),
    topbar: true,
  },
] as const;

const tabs = nav.filter((item) => 'tab' in item && item.tab);
const topbarLinks = nav.filter((item) => 'topbar' in item && item.topbar);
---

<!doctype html>
<html
  lang="en"
  data-theme="system"
  data-resolved="light"
  data-font="md"
  data-title-en={title}
  data-title-fr={titleFr}
  data-description-en={description}
  data-description-fr={descriptionFr}
  data-og-title-en={ogTitle}
  data-og-title-fr={ogTitleFr}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#131925" />
    <meta name="color-scheme" content="light dark" />
    <meta name="generator" content={Astro.generator} />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Citizenship" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <link rel="canonical" href={canonical} />
    <link rel="describedby" href={llmsUrl} type="text/markdown" title="llms.txt" />
    <link rel="alternate" type="text/markdown" href={indexMdUrl} title="Markdown overview" />
    <link
      rel="api-catalog"
      href={apiCatalogUrl}
      type="application/linkset+json"
      title="API catalog"
    />
    <link rel="service-desc" href={openApiUrl} type="application/openapi+json" title="OpenAPI" />
    <link rel="sitemap" type="application/xml" href={sitemapUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Prepare Citizenship" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Prepare Citizenship — practice for the citizenship test. Free, no account, works offline."
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    {pwaInfo && <Fragment set:html={pwaInfo.webManifest.linkTag} />}
    <title>{title}</title>
    <script is:inline type="application/ld+json" set:html={siteJsonLd} />
    <script src="../pwa.ts"></script>
    <script is:inline>
      (function () {
        try {
          var raw = localStorage.getItem('prepare-citizenship.progress.v1');
          var settings = raw ? JSON.parse(raw).settings || {} : {};
          var locale = settings.locale === 'fr' ? 'fr' : 'en';
          var theme = settings.theme === 'light' || settings.theme === 'dark' ? settings.theme : 'system';
          var font = settings.fontSize === 'lg' || settings.fontSize === 'xl' ? settings.fontSize : 'md';
          var dark =
            theme === 'dark' ||
            (theme === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
          document.documentElement.lang = locale;
          document.documentElement.dataset.locale = locale;
          var localizedTitle = document.documentElement.dataset[locale === 'fr' ? 'titleFr' : 'titleEn'];
          var localizedDescription =
            document.documentElement.dataset[locale === 'fr' ? 'descriptionFr' : 'descriptionEn'];
          var localizedOgTitle =
            document.documentElement.dataset[locale === 'fr' ? 'ogTitleFr' : 'ogTitleEn'];
          document.title = localizedTitle || document.title;
          var descriptionMeta = document.querySelector('meta[name="description"]');
          var ogDescription = document.querySelector('meta[property="og:description"]');
          var twitterDescription = document.querySelector('meta[name="twitter:description"]');
          var ogTitleMeta = document.querySelector('meta[property="og:title"]');
          var twitterTitle = document.querySelector('meta[name="twitter:title"]');
          var ogImageAlt = document.querySelector('meta[property="og:image:alt"]');
          var appTitle = document.querySelector('meta[name="apple-mobile-web-app-title"]');
          var manifest = document.querySelector('link[rel="manifest"]');
          if (descriptionMeta) descriptionMeta.content = localizedDescription;
          if (ogDescription) ogDescription.content = localizedDescription;
          if (twitterDescription) twitterDescription.content = localizedDescription;
          if (ogTitleMeta) ogTitleMeta.content = localizedOgTitle;
          if (twitterTitle) twitterTitle.content = localizedOgTitle;
          if (locale === 'fr' && ogImageAlt) {
            ogImageAlt.content =
              'Prepare Citizenship — préparation à l’examen de citoyenneté. Gratuit, sans compte et accessible hors ligne.';
          }
          if (locale === 'fr' && appTitle) appTitle.content = 'Citoyenneté';
          if (locale === 'fr' && manifest) manifest.href = '/manifest-fr.webmanifest';
          document.documentElement.dataset.theme = theme;
          document.documentElement.dataset.resolved = dark ? 'dark' : 'light';
          document.documentElement.dataset.font = font;
        } catch (error) {
          /* keep defaults */
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main" data-i18n="skip">Skip to content</a>
    <div class="app">
      <aside class="rail">
        <a class="rail-brand" href={homeHref}>
          <MapleLeaf />
          Prepare Citizenship
        </a>
        <nav class="rail-nav" aria-label="Primary" data-i18n-aria="nav.primary">
          {
            nav.map((item) => (
              <a href={item.href} aria-current={item.current ? 'page' : undefined}>
                <Icon name={item.icon} />
                <span data-i18n={item.i18n}>{item.label}</span>
              </a>
            ))
          }
        </nav>
        <div class="rail-widget" x-data="dashboardPage">
          <template x-if="stats">
            <div>
              <p class="k" x-text="$store.i18n.t('rail.streak')">Study streak</p>
              <p class="v" x-text="$store.i18n.t(stats.streak === 1 ? 'rail.day' : 'rail.days', { n: stats.streak })"></p>
              <p class="k" style="margin-top:0.8rem" x-text="$store.i18n.t('rail.accuracy')">Accuracy</p>
              <p
                class="v"
                x-text="stats.overallTotal ? $store.i18n.t('rail.of', { pct: Math.round(stats.overallRate * 100), total: stats.overallTotal }) : $store.i18n.t('rail.noAnswers')"
              ></p>
            </div>
          </template>
        </div>
        <a class="rail-user" href={`${homeHref}settings/`} x-data>
          <span class="avatar" aria-hidden="true">
            <span class="avatar-leaf" x-show="!$store.learner.name">
              <MapleLeaf class="avatar-glyph" />
            </span>
            <span
              x-show="$store.learner.name"
              x-cloak
              x-text="($store.learner.name || '').slice(0, 1).toUpperCase()"></span>
          </span>
          <span class="rail-user-text">
            <strong x-text="$store.learner.name || $store.i18n.t('brand.addName')">Add your name</strong>
            <span data-i18n="nav.settings">Settings</span>
          </span>
          <Icon name="chevron" />
        </a>
      </aside>

      <div class="content">
        <header class="topbar" x-data="siteHeader">
          <a class="topbar-brand" href={homeHref}>
            <MapleLeaf />
            <span class="brand-full">Prepare Citizenship</span>
            <span class="brand-short lang-en">Citizenship</span>
            <span class="brand-short lang-fr">Citoyenneté</span>
          </a>
          <p class="topbar-context">
            <span class="lang-en">{context ?? title}</span>
            <span class="lang-fr">{contextFr}</span>
          </p>
          <div class="topbar-actions">
            {
              topbarLinks.map((item) => (
                <a
                  class="icon-button only-mobile"
                  href={item.href}
                  aria-label={item.label}
                  title={item.label}
                  data-i18n-aria={item.i18n}
                  data-i18n-title={item.i18n}
                  aria-current={item.current ? 'page' : undefined}
                >
                  <Icon name={item.icon} />
                </a>
              ))
            }
            <button
              class="icon-button"
              type="button"
              @click="cycleTheme"
              :aria-label="$store.i18n.t('theme.switch', { current: themeLabel, next: nextThemeLabel })"
              :title="$store.i18n.t('theme.switch', { current: themeLabel, next: nextThemeLabel })"
            >
              <span x-show="theme === 'system'"><Icon name="auto" /></span>
              <span x-show="theme === 'light'" x-cloak><Icon name="sun" /></span>
              <span x-show="theme === 'dark'" x-cloak><Icon name="moon" /></span>
              <span class="theme-label" x-text="themeLabel">Auto</span>
            </button>
          </div>
        </header>

        <StorageBanner />

        <main id="main" class="site-main" tabindex="-1">
          <slot />
        </main>
      </div>
    </div>

    <nav class="tabbar" aria-label="Sections" data-i18n-aria="nav.sections">
      {
        tabs.map((item) => (
          <a href={item.href} aria-current={item.current ? 'page' : undefined}>
            <Icon name={item.icon} />
            <span data-i18n={'tabI18n' in item ? item.tabI18n : item.i18n}>
              {'tabLabel' in item ? item.tabLabel : item.label}
            </span>
          </a>
        ))
      }
    </nav>
  </body>
</html>
