---
import MapleLeaf from '../components/MapleLeaf.astro';
import StorageBanner from '../components/StorageBanner.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL;
const homeHref = base.endsWith('/') ? base : `${base}/`;
const chaptersHref = `${homeHref}chapters/`;
const path = Astro.url.pathname;
const officialGuideUrl =
  'https://www.canada.ca/en/immigration-refugees-citizenship/services/canadian-citizenship/test/study.html';

const nav = [
  { href: homeHref, label: 'Home', current: path === homeHref || path === base },
  { href: chaptersHref, label: 'Chapters', current: path.includes('/chapters') },
  { href: `${homeHref}flashcards/`, label: 'Flashcards', current: path.includes('/flashcards') },
  { href: `${homeHref}practice/`, label: 'Practice', current: path.includes('/practice') },
  { href: `${homeHref}mock/`, label: 'Mock', current: path.includes('/mock') },
  { href: `${homeHref}progress/`, label: 'Progress', current: path.includes('/progress') },
  { href: `${homeHref}settings/`, label: 'Settings', current: path.includes('/settings') },
];
---

<!doctype html>
<html lang="en" data-theme="system" data-resolved="light" data-font="md">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#c8102e" />
    <meta name="color-scheme" content="light dark" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script is:inline>
      (function () {
        try {
          var raw = localStorage.getItem('prepare-citizenship.progress.v1');
          var settings = raw ? JSON.parse(raw).settings || {} : {};
          var theme = settings.theme === 'light' || settings.theme === 'dark' ? settings.theme : 'system';
          var font = settings.fontSize === 'lg' || settings.fontSize === 'xl' ? settings.fontSize : 'md';
          var dark =
            theme === 'dark' ||
            (theme === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
          document.documentElement.dataset.theme = theme;
          document.documentElement.dataset.resolved = dark ? 'dark' : 'light';
          document.documentElement.dataset.font = font;
        } catch (error) {
          /* keep defaults */
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="flag-stripe" aria-hidden="true">
      <span></span>
      <span></span>
      <span></span>
    </div>
    <header
      class="site-header"
      x-data="siteHeader"
      :class="menuOpen && 'menu-open'"
      @keydown.escape="menuOpen = false"
      @click.outside="menuOpen = false"
    >
      <a class="wordmark" href={homeHref}>
        <MapleLeaf />
        Prepare Citizenship
      </a>
      <div class="header-actions">
        <button
          class="chip theme-toggle"
          type="button"
          @click="cycleTheme"
          :aria-label="`Theme: ${themeLabel}. Switch to ${nextThemeLabel}.`"
          :title="`Theme: ${themeLabel}. Switch to ${nextThemeLabel}.`"
        >
          <span class="theme-dot" aria-hidden="true"></span>
          <span x-text="themeLabel">Auto</span>
        </button>
        <button
          class="chip nav-toggle"
          type="button"
          aria-controls="primary-nav"
          :aria-expanded="menuOpen.toString()"
          @click="menuOpen = !menuOpen"
        >
          <span x-text="menuOpen ? 'Close' : 'Menu'">Menu</span>
        </button>
      </div>
      <nav class="nav" id="primary-nav" aria-label="Primary">
        {
          nav.map((item) => (
            <a
              href={item.href}
              aria-current={item.current ? 'page' : undefined}
              {...{ '@click': 'menuOpen = false' }}
            >
              {item.label}
            </a>
          ))
        }
      </nav>
    </header>
    <StorageBanner />
    <main id="main" class="site-main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      Independent study tool—not affiliated with Immigration, Refugees and
      Citizenship Canada. For authoritative material, use the
      <a href={officialGuideUrl}>official study guide</a>. Practice questions
      here are original paraphrases, not the real test bank.
    </footer>
  </body>
</html>
